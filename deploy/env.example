# ===== 校园失物招领系统 开发环境变量示例 =====
# 复制为 deploy/.env 后按需修改；严禁在本文件填写真实密钥。

# ---- 后端服务 ----
SERVER_PORT=8080
API_BASE_PATH=/api/v1

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_lost_found
DB_USERNAME=clf_app
DB_PASSWORD=change_me_in_local_only
# 隔离测试/恢复库（绝不指向生产）
DB_TEST_NAME=campus_lost_found_test

# ---- 会话 / Token ----
# 生产必须使用足够长度的随机密钥；此处仅示例占位
JWT_SECRET=please_generate_a_long_random_secret_for_local
ACCESS_TOKEN_TTL_MINUTES=120
REFRESH_TOKEN_TTL_DAYS=7

# ---- 文件存储（开发期受控本地目录） ----
FILE_STORAGE_ROOT=./storage
FILE_MAX_SIZE_MB=5
FILE_MAX_COUNT_PER_POST=6
FILE_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---- 测试登录（仅开发/测试环境；生产必须为 false） ----
MOCK_LOGIN_ENABLED=true

# ---- 校园身份认证（本期禁用） ----
CAMPUS_IDENTITY_PROVIDER=disabled

# ---- 微信小程序（待合法取得凭据后填写；缺省则真实微信登录不可用） ----
WECHAT_APPID=
WECHAT_APPSECRET=

# ---- 管理员初始账号（仅用于开发环境种子；生产禁用弱口令） ----
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=set_a_strong_password_locally
