# ===== 校园失物招领系统 开发环境变量示例 =====
# 复制为 deploy/.env 后按需修改；严禁在本文件填写真实密钥。

# ---- 后端服务 ----
SERVER_PORT=8080
API_BASE_PATH=/api/v1

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_lost_found
DB_USERNAME=clf_app
DB_PASSWORD=change_me_in_local_only
# 隔离测试/恢复库（绝不指向生产）
DB_TEST_NAME=campus_lost_found_test

# ---- 会话 / Token ----
# 生产必须使用足够长度的随机密钥；此处仅示例占位
JWT_SECRET=please_generate_a_long_random_secret_for_local
ACCESS_TOKEN_TTL_MINUTES=120
# 注：REFRESH_TOKEN_TTL_DAYS 已废弃（D16）——续期采用"签发新短期 token + 撤销旧会话"模型，无独立 refresh TTL

# ---- 文件存储（开发期受控本地目录） ----
FILE_STORAGE_ROOT=./storage
FILE_MAX_SIZE_MB=5                       # FileService 业务级单张上限(MB)
FILE_MAX_COUNT_PER_POST=6               # 单帖/单对象图片数量上限（替换绑定时去重后校验）
FILE_ALLOWED_MIME=image/jpeg,image/png,image/webp
# Spring multipart 上限，略大于业务值，让业务校验先行返回 FILE_TOO_LARGE（P0-1）
FILE_SPRING_MAX_SIZE=6MB
FILE_SPRING_MAX_REQUEST=10MB
# 孤儿文件定时清理开关：删除 bound=0 且超 24h 的未绑定上传（D13/R6）
FILE_ORPHAN_CLEANUP=true

# ---- 备份（D13/R7） ----
APP_BACKUP_DIR=./backups                # 备份输出目录（原硬编码，现配置化）

# ---- 匹配权重与阈值（默认值即当前调参结果；不建议随意改动，改前先跑 match-eval） ----
MATCH_W_CATEGORY=0.40                   # 类别子分权重
MATCH_W_LOCATION=0.25                   # 地点子分权重
MATCH_W_TIME=0.30                       # 时间子分权重
MATCH_W_KEYWORD=0.05                    # 关键词子分权重
MATCH_TIME_WINDOW_DAYS=14              # 时间评分窗口（天）
MATCH_TIME_TOLERANCE_HOURS=24         # 允许拾取早于丢失的误差容忍（小时）
MATCH_MAX_CANDIDATES=20               # 候选最多返回条数
MATCH_MIN_SCORE=0.70                  # 入选最低分阈值
NULL_EVENT_WINDOW_DAYS=60            # event_time 为空候选按发布时间回看天数（第三臂兜底）
CANDIDATE_ARM_LIMIT=500             # 每个候选臂的安全上限（保险阀）
SAME_PARENT_SCORE=0.5              # 同父类别部分得分
CATEGORY_WINDOW_DAYS=90           # 同类目臂窗口（天）
W_UNIGRAM=0.5                     # K 子分 unigram Jaccard 权重
W_BIGRAM=0.5                      # K 子分 bigram Jaccard 权重
CAMPUS_MISMATCH_FACTOR=0.3        # 两边校区都填但不同时的地点分乘数

# ---- 测试登录（仅开发/测试环境；生产必须为 false） ----
MOCK_LOGIN_ENABLED=true

# ---- 校园身份认证（本期禁用） ----
CAMPUS_IDENTITY_PROVIDER=disabled

# ---- 微信小程序（待合法取得凭据后填写；缺省则真实微信登录不可用） ----
WECHAT_APPID=
WECHAT_APPSECRET=

# ---- 管理员初始账号（仅用于开发环境种子；生产禁用弱口令） ----
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=set_a_strong_password_locally
